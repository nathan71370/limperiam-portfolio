# Copy to .env on the home server. NEVER commit the real .env.
# Generate a strong JWT_SECRET with: openssl rand -hex 32

# Auth
JWT_SECRET=replace-me-with-32-random-bytes
ADMIN_EMAIL=nathanmercier@limperiam.com
ADMIN_PASSWORD=use-a-long-password-here

# Optional Cal.com link (shows "Réserver un créneau" / "Book a slot" button)
# Example: nathan-mercier/30min
NEXT_PUBLIC_CALCOM_LINK=

# Host port the web service binds to on 127.0.0.1. Defaults to 3000.
# Set to your existing tunnel/reverse-proxy target to avoid changing
# Cloudflared / Caddy / Traefik config when swapping containers.
# Example: WEB_PORT=1234
WEB_PORT=3000
